{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "no-explicit-any",
        "Explicit-Function-Return-Type",
        "no-console",
        "eqeqeq",
        "no-non-null-assertion",
        "no-unused-vars"
      ]
    },
    "exclude": ["dist/", "node_modules/", ".deno_coverage/"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": ["dist/", "node_modules/", ".deno_coverage/"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    "fmt": "deno fmt src/ tests/",
    "fmt:check": "deno fmt --check src/ tests/",
    "lint": "deno lint src/ tests/",
    "check": "deno check src/ tests/",
    "test:arquitectura": "deno test --allow-read tests/arquitectura/",
    "test": "deno test --allow-read --allow-env tests/",
    "coverage": "deno test --allow-read --allow-env --coverage=.deno_coverage tests/ && deno coverage .deno_coverage",
    "ci:static": "deno task fmt:check && deno task lint && deno task check && deno task test:arquitectura",
    "ci:test": "deno task test",
    "ci": "deno task ci:static && deno task ci:test"
  }
}
