{
  "workspace": [
    "./shared",
    "./{{APP_1}}",
    "./{{APP_2}}"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "react"
      ]
    }
  },
  "tasks": {
    "dev": "deno task dev:{{APP_1}} & deno task dev:{{APP_2}}",
    "dev:{{APP_1}}": "deno task --cwd {{APP_1}} dev",
    "dev:{{APP_2}}": "deno task --cwd {{APP_2}} dev",
    "build:{{APP_1}}": "deno task --cwd {{APP_1}} build",
    "build:{{APP_2}}": "deno task --cwd {{APP_2}} build",
    "build": "deno task build:{{APP_1}} && deno task build:{{APP_2}}",
    "fmt": "deno fmt shared/ {{APP_1}}/src/ {{APP_2}}/src/ tests/",
    "fmt:check": "deno fmt --check shared/ {{APP_1}}/src/ {{APP_2}}/src/ tests/",
    "lint": "deno lint shared/ {{APP_1}}/src/ {{APP_2}}/src/ tests/",
    "check": "deno check shared/ {{APP_1}}/src/ {{APP_2}}/src/ tests/",
    "test:shared": "deno test --allow-read --allow-env shared/",
    "test:{{APP_1}}": "deno test --allow-read --allow-env {{APP_1}}/",
    "test:{{APP_2}}": "deno test --allow-read --allow-env {{APP_2}}/",
    "test": "deno test --allow-read --allow-env --parallel",
    "test:watch": "deno test --allow-read --allow-env --watch",
    "ci:static": "deno task fmt:check && deno task lint && deno task check",
    "coverage": "deno coverage coverage",
    "ci:test": "rm -rf coverage && deno task test --coverage=coverage --coverage-raw-data-only && deno task coverage",
    "ci:build": "deno task build",
    "ci": "deno task ci:static && deno task ci:test && deno task ci:build"
  },
  "coverage": {
    "thresholds": {
      "lines": 84,
      "branches": 80,
      "functions": 62
    }
  }
}
